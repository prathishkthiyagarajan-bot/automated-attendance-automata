{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Attendance System (Flask + React)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Run DFA Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/tests/test_dfa.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run End-to-End API Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/tests/test_e2e.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
